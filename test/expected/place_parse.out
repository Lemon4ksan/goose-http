set front = 0-3 exclusive
set flows = 4-5
set db = 6-7, 12-15
set writer (a role's own) = 7
workers = 4 each front incoming
hasher = 1 within flows
checkout = 1 within flows low
writer = 0 within writer
reports = 4 within db
seats on 16 cores:
  workers 0: 0 incoming 0
  workers 1: 1 incoming 1
  workers 2: 2 incoming 2
  workers 3: 3 incoming 3
  workers 4: 0 incoming 0
  hasher 0: 4-5
  checkout 0: 4-5 low
  writer 0: 7
  reports 3: 6-7, 12-15
  mailer 0: 4-15
threads: workers 4, writer 1, mailer 2
seats on cores 0-1, 4-7:
  workers 0: 0 incoming 0
  workers 1: 1 incoming 1
  workers 2: 0 incoming 0
  reports 0: 6-7
  mailer 0: 4-7
threads: workers 4
seats with an exclusive set:
  writer 0: 4-7
  reports 0: 4-5
  other 0: 4-7
threads: reports 2
seats where threads can't be pinned:
  workers 0: floats
  checkout 0: floats low
dev: workers 2
  workers 0: floats
  hasher 0: floats low
crlf and tabs: error ""
set front = 0-1, 3 exclusive
workers = 2 each front
hasher = 1 low
bad.place:1: NAME = ..., or set NAME = cores
bad.place:1: a thread count of 1 or more, not "0"
bad.place:1: each needs a set or cores
bad.place:1: no set front above
bad.place:1: a count, each, within, core, low, or incoming, not "everywhere"
bad.place:1: core takes one core: within takes several
bad.place:1: one of each, within, or core, not two
bad.place:1: cores, then exclusive or nothing, not "shared"
bad.place:1: a range from low to high, not "3-0"
bad.place:1: a core from 0 to 1023, not "1024"
bad.place:1: cores, as 0-3, 8
bad.place:2: set front twice
bad.place:1: NAME = ..., or set NAME = cores
bad.place:1: a name of letters, digits, _ and -, not "w√rkers"
bad.place:2: workers twice
