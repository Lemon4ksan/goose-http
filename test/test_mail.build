// The C test_mail.goose needs, since it declares the package by mail.goose,
// which has no sidecar of its own: the mailbox, and the platform's waker.
c_sources_macos = ["../shim/mail.c", "../shim/kqueue.c"];
c_sources_linux = ["../shim/mail.c", "../shim/net.c"];
c_sources_windows = ["../shim/mail.c", "../shim/net_win.c", "../shim/iocp.c"];
c_libs_windows = ["ws2_32", "mswsock"];
c_flags_msvc = ["/std:c11"];
